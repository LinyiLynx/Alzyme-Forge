integrator  = md
nsteps      = 1000000
dt          = 0.002
nstlog      = 1000
nstenergy   = 1000
nstxout-compressed = 5000
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb    = 1.0
rvdw        = 1.0
constraints = h-bonds
constraint_algorithm = lincs
tcoupl      = V-rescale
tc-grps     = System
tau_t       = 0.1
ref_t       = 300
pcoupl      = Parrinello-Rahman
pcoupltype  = isotropic
tau_p       = 2.0
ref_p       = 1.0
compressibility = 4.5e-5
continuation = yes
gen_vel     = no
