integrator  = md
nsteps      = 50000
dt          = 0.002
nstlog      = 1000
nstenergy   = 1000
nstxout-compressed = 5000
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb    = 1.0
rvdw        = 1.0
constraints = h-bonds
constraint_algorithm = lincs
tcoupl      = V-rescale
tc-grps     = System
tau_t       = 0.1
ref_t       = 300
pcoupl      = no
gen_vel     = yes
gen_temp    = 300
gen_seed    = -1
